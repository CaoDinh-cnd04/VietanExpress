# Cấu hình app Shopify của Việt An (Shopify CLI: đổi tên thành shopify.app.toml rồi `shopify app deploy`).
# Không dùng CLI: khai các giá trị tương ứng trong Dev Dashboard → app → Versions → Create a version.
# client_id là công khai; client secret KHÔNG để ở đây (chỉ ở backend: Shopify__ClientSecret).

client_id = "<Shopify:ClientId>"
name = "Việt An Express"
application_url = "https://viet-an-express.vercel.app/ecommerce"
embedded = false

[access_scopes]
scopes = "read_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"

[auth]
redirect_urls = ["https://viet-an-express.vercel.app/api/v1/ecom/oauth/shopify/callback"]

[webhooks]
api_version = "2026-07"

  # Đơn mới / đơn sửa → backend đồng bộ nền; gỡ app → kết nối "revoked".
  [[webhooks.subscriptions]]
  topics = ["app/uninstalled", "orders/create", "orders/updated"]
  uri = "https://viet-an-express.vercel.app/api/v1/ecom/webhooks/shopify"

  # 3 webhook compliance (GDPR) bắt buộc với app public — dùng chung 1 URL, backend phân theo X-Shopify-Topic.
  [[webhooks.subscriptions]]
  compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
  uri = "https://viet-an-express.vercel.app/api/v1/ecom/webhooks/shopify"
