# ============================================================
#  VIỆT AN EXPRESS PORTAL — cấu hình frontend (web/)
#  Sao chép thành web/.env.local rồi sửa giá trị (Vite chỉ đọc biến có tiền tố VITE_).
# ============================================================

# Địa chỉ API backend. Mặc định /api/v1 — khi dev, Vite proxy /api sang http://localhost:3000.
# Production khác domain: VITE_API_BASE_URL=https://api.vietanexpress.com.vn/api/v1
VITE_API_BASE_URL=/api/v1
